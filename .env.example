# Copy to .env and fill in. Real environment variables take precedence.

# Local:    postgresql://postgres:postgres@localhost:5432/qydyr
# Supabase: Project Settings -> Database -> Connection string (Session pooler, works over IPv4)
DATABASE_URL=

# Claude API key (platform.claude.com) — request understanding, event extraction, translation, photos
ANTHROPIC_API_KEY=
# Defaults: Haiku 5.5 for volume, Sonnet 5.5 for language quality and photos
QYDYR_CLAUDE_MODEL=claude-haiku-5-5
QYDYR_CLAUDE_MODEL_SMART=claude-sonnet-5-5

# Telegram: token from @BotFather. The Mini App needs a public https address of this server
# (Render/Railway URL, or `make tunnel` for a temporary one).
TELEGRAM_BOT_TOKEN=
QYDYR_PUBLIC_URL=
# Only when the bot runs separately from the API:
QYDYR_API_URL=

# Map styles (MapLibre). Defaults: free CARTO basemaps with OpenStreetMap data.
# QYDYR_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# QYDYR_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Demo mode for rehearsals and the video: frozen time and weather from files
# QYDYR_DEMO_NOW=2026-10-23T19:10
# QYDYR_WEATHER_FILE=tests/fixtures/weather_mild.json
# QYDYR_AIR_FILE=tests/fixtures/air_good.json

# Identify yourself to the sites you read (put a repo URL or team contact here)
QYDYR_USER_AGENT=QydyrBot/0.1 (city walking assistant prototype; Build with AI hackathon, Astana)
